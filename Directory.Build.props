<Project>
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <NoWarn>SA1633</NoWarn>
    </PropertyGroup>
</Project>
